// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  image         String?
  name          String?
  password      String?   // Added password field for credentials auth
  role          UserRole  @default(TENANT)
  phone         String?
  address       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  accounts      Account[]
  sessions      Session[]
  
  // Tenant specific
  tenantProfile TenantProfile?
  applications  Application[]
  tenancy       Tenant[]
  
  // Owner specific
  ownerProfile  OwnerProfile?
  properties    Property[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TenantProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  age             Int?
  occupation      String?
  monthlyIncome   Float?
  emergencyContact String?
  preferences     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OwnerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  businessName    String?
  businessLicense String?
  experienceYears Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Property {
  id                String   @id @default(cuid())
  ownerId           String
  pgNumber          String   @unique
  name              String
  address           String
  city              String
  state             String
  pincode           String
  description       String?
  totalRooms        Int
  availableRooms    Int
  rentPerMonth      Float
  securityDeposit   Float
  amenities         String?
  rules             String?
  images            String?
  sharingType       String?  // Added for sharing type filter
  isVerified        Boolean  @default(false) // Added for verified PGs
  rating            Float?   // Added for rating
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  applications Application[]
  rooms        Room[]
  tenants      Tenant[]
  payments     Payment[]
}

model Room {
  id          String   @id @default(cuid())
  propertyId  String
  roomNumber  String
  roomType    RoomType
  capacity    Int
  isOccupied  Boolean  @default(false)
  rentAmount  Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenants  Tenant[]
}

model Tenant {
  id           String    @id @default(cuid())
  userId       String
  propertyId   String
  roomId       String?
  moveInDate   DateTime
  moveOutDate  DateTime?
  securityDeposit Float
  monthlyRent  Float
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room     Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  payments Payment[]
}

model Payment {
  id           String        @id @default(cuid())
  tenantId     String
  propertyId   String
  amount       Float
  dueDate      DateTime
  paidDate     DateTime?
  status       PaymentStatus @default(PENDING)
  paymentType  PaymentType   @default(RENT)
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Application {
  id         String            @id @default(cuid())
  tenantId   String
  propertyId String
  status     ApplicationStatus @default(PENDING)
  message    String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  
  tenant   User     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, propertyId])
}

enum UserRole {
  TENANT
  OWNER
  ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RoomType {
  SINGLE
  DOUBLE
  TRIPLE
  SHARING
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentType {
  RENT
  SECURITY_DEPOSIT
  MAINTENANCE
  ELECTRICITY
  OTHER
}
